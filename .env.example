# Copy to .env in the repo root and fill in. Only EXPO_PUBLIC_* vars reach the client bundle.
# Expo reads env from apps/mobile/: ln -sf ../../.env apps/mobile/.env
# After `pnpm db:start`, run `supabase status` and copy:
#   API_URL  → EXPO_PUBLIC_SUPABASE_URL
#   ANON_KEY → EXPO_PUBLIC_SUPABASE_ANON_KEY (JWT starting with eyJ…)
# Do NOT use PUBLISHABLE_KEY (sb_publishable_…) in the app — that breaks API auth.
# iOS Simulator: http://127.0.0.1:54321 is fine. Physical device: use your Mac's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Admin dashboard (Next.js) — same Supabase project; anon key only (no service role in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Chat photo/file attachments need local Supabase + migrations:
#   pnpm db:start && pnpm db:migrate   (or pnpm db:reset for a clean DB)
# Hosted projects: push migrations (e.g. supabase db push) so RPCs like
# begin_request_message_with_attachments and the conversation-media bucket exist.

# Paystack (server-side only — used by Supabase Edge Functions, NOT bundled into Expo)
# Set these in the same `.env` file for local `supabase functions serve --env-file ../.env`
# See docs/paystack-environment.md
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Optional later, when checkout UI needs the test public key in the app:
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# NIN withdrawal identity (server-side only — Edge Functions via pnpm db:serve)
# Generate: openssl rand -base64 32  (run twice for two different keys)
NIN_ENCRYPTION_KEY=
NIN_FINGERPRINT_KEY=
