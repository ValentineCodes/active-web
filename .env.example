# Copy to .env and fill in. Only EXPO_PUBLIC_* vars reach the client bundle.
# After `pnpm db:start`, run `supabase status` and copy:
#   API_URL  → EXPO_PUBLIC_SUPABASE_URL
#   ANON_KEY → EXPO_PUBLIC_SUPABASE_ANON_KEY (JWT starting with eyJ…)
# Do NOT use PUBLISHABLE_KEY (sb_publishable_…) in the app — that breaks API auth.
# iOS Simulator: http://127.0.0.1:54321 is fine. Physical device: use your Mac's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Paystack (server-side only — used by Supabase Edge Functions, NOT bundled into Expo)
# Set these in the same `.env` file for local `supabase functions serve --env-file ../.env`
# See docs/paystack-environment.md
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Optional later, when checkout UI needs the test public key in the app:
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
