# Copy to `.env` in the repo root (never commit real secrets).
# Edge Functions read Paystack vars via `supabase/config.toml` → `[edge_runtime.secrets]`.
# Local serve: `supabase functions serve --env-file .env`

# Paystack test mode only (https://dashboard.paystack.com → Settings → API Keys → Test)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_BASE_URL=https://api.paystack.co
