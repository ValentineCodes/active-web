{
  "name": "active",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "pnpm --filter @active/mobile start",
    "android": "pnpm --filter @active/mobile android",
    "ios": "pnpm --filter @active/mobile ios",
    "prebuild": "pnpm --filter @active/mobile prebuild",
    "build:android:dev": "pnpm --filter @active/mobile build:android:dev",
    "build:android:preview": "pnpm --filter @active/mobile build:android:preview",
    "build:android:prod": "pnpm --filter @active/mobile build:android:prod",
    "build:configure": "pnpm --filter @active/mobile build:configure",
    "build:ios:dev": "pnpm --filter @active/mobile build:ios:dev",
    "build:ios:preview": "pnpm --filter @active/mobile build:ios:preview",
    "build:ios:prod": "pnpm --filter @active/mobile build:ios:prod",
    "eas:init": "pnpm --filter @active/mobile eas:init",
    "eas:login": "pnpm --filter @active/mobile eas:login",
    "eas:whoami": "pnpm --filter @active/mobile eas:whoami",
    "submit:android": "pnpm --filter @active/mobile submit:android",
    "submit:ios": "pnpm --filter @active/mobile submit:ios",
    "test:request-response-sections": "pnpm --filter @active/mobile test:request-response-sections",
    "test:bank-account-lookup": "pnpm --filter @active/mobile test:bank-account-lookup",
    "typecheck": "pnpm --filter @active/mobile typecheck",
    "lint": "pnpm --filter @active/mobile lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:start": "supabase start",
    "db:serve": "supabase functions serve --env-file .env",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "db:types": "supabase gen types typescript --local --schema public > apps/mobile/src/lib/supabase/database.types.ts",
    "db:seed-admin": "supabase db query --local -f supabase/seed.sql",
    "db:test": "supabase test db",
    "functions:test": "PATH=\"${PWD}/.deno/bin:${PATH}\" deno test supabase/functions/_shared/deposit/settle_test.ts supabase/functions/_shared/paystack/nuban_test.ts supabase/functions/_shared/paystack/resolution-response_test.ts supabase/functions/_shared/paystack/resolve-rate-limit_test.ts supabase/functions/_shared/nin/validate_test.ts supabase/functions/_shared/nin/crypto_test.ts",
    "admin:dev": "pnpm --filter @active/admin dev",
    "admin:build": "pnpm --filter @active/admin build",
    "admin:typecheck": "pnpm --filter @active/admin typecheck",
    "website:dev": "pnpm --filter @active/website dev",
    "website:build": "pnpm --filter @active/website build",
    "website:typecheck": "pnpm --filter @active/website typecheck",
    "validate": "pnpm --filter @active/mobile validate && pnpm --filter @active/admin typecheck && pnpm --filter @active/website typecheck && pnpm --filter @active/website build && pnpm format"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
