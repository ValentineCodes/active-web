{
  "expo": {
    "name": "Active",
    "slug": "active",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "active",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.active.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.active.app",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Active uses your location when you post a request or browse and respond to nearby ones. Your exact location stays hidden until someone is selected."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Active needs access to your photos so you can add work samples to your profile.",
          "cameraPermission": "Active needs your camera to capture your profile photo and optional profile media."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "largeIcon": "./assets/images/icon.png",
          "color": "#10B981"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 240,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-image",
      "expo-font",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "dewdrip",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ba8914c-e98a-4923-bf59-cdef3e5fb357"
      }
    }
  }
}
