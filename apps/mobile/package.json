{
  "name": "@active/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:prod": "npx eas-cli@latest build --platform android --profile production",
    "build:configure": "npx eas-cli@latest build:configure",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:prod": "npx eas-cli@latest build --platform ios --profile production",
    "eas:init": "npx eas-cli@latest init",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami",
    "submit:android": "npx eas-cli@latest submit --platform android",
    "submit:ios": "npx eas-cli@latest submit --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:request-response-sections": "node --experimental-strip-types src/features/requests/request-response-sections.test.ts",
    "test:bank-account-lookup": "node --experimental-strip-types src/features/profile/use-bank-account-lookup.test.ts",
    "test:withdraw-status": "node --experimental-strip-types src/features/wallet/withdraw-status.test.ts",
    "test:withdraw-nin-flow": "node --experimental-strip-types src/features/wallet/withdraw-nin-flow.test.ts",
    "test:chat-send-eligibility": "node --experimental-strip-types src/features/requests/chat-send-eligibility.test.ts",
    "test:completion-proof": "node --experimental-strip-types src/features/requests/completion-proof.test.ts",
    "validate": "pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.3",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.9",
    "expo-dev-client": "~58.0.11",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.5",
    "expo-font": "~58.0.6",
    "expo-haptics": "~58.0.4",
    "expo-image": "~58.0.11",
    "expo-image-manipulator": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.10",
    "expo-location": "~58.0.11",
    "expo-notifications": "~58.1.0",
    "expo-router": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.6",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "input-otp-native": "^0.6.0",
    "nativewind": "^4.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-pager-view": "9.0.4",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-tab-view": "^4.3.3",
    "react-native-toast-notifications": "^3.4.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3"
  }
}
