# Copy to apps/pwa/.env — anon JWT only (starts with eyJ…).
VITE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Phone on same Wi‑Fi: use your Mac LAN IP for Supabase (port 54321), add
# http://<lan-ip>:3002 to supabase/config.toml additional_redirect_urls, then
# `supabase stop && supabase start`. Run `pnpm pwa:dev` (Vite on 0.0.0.0:3002).

# Optional fallbacks (vite.config.ts also reads these from the monorepo root):
# NEXT_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_URL=